// PROPOSED, NOT APPLIED. Phase N2 ACL narrowing (docs/SPEC-networking.md section 5).
// Apply only after every node runs the N2 runner with loopback Ollama (see docs/NETWORKING-OWNER-CHECKLIST.md, N2).
// Difference from tailscale/policy.hujson: master reaches workers on the runner port 11436 only.
// Raw engine ports (11434, 11435, 12434, 1234, 8000, 8080) are no longer granted to anyone.
{
  "tagOwners": {
    "tag:master":   ["autogroup:admin"],
    "tag:llm-node": ["autogroup:admin"],
  },

  "grants": [
    {"src": ["tag:master"], "dst": ["tag:llm-node"], "ip": ["tcp:11436"]},
    {"src": ["tag:llm-node"], "dst": ["tag:master"], "ip": ["tcp:8443"]},
    {"src": ["autogroup:member"], "dst": ["tag:master"], "ip": ["tcp:8443"]},
    {"src": ["autogroup:admin"], "dst": ["tag:master", "tag:llm-node"], "ip": ["tcp:22"]},
  ],

  "tests": [
    {"src": "tag:master", "accept": ["tag:llm-node:11436"],
     "deny": ["tag:llm-node:11434", "tag:llm-node:11435", "tag:llm-node:12434", "tag:llm-node:1234", "tag:llm-node:8000", "tag:llm-node:8080", "tag:llm-node:22"]},
    {"src": "tag:llm-node", "accept": ["tag:master:8443"],
     "deny": ["tag:master:4000", "tag:master:8700", "tag:llm-node:11434", "tag:llm-node:11435", "tag:llm-node:11436", "tag:llm-node:12434", "tag:llm-node:1234", "tag:llm-node:8000", "tag:llm-node:8080", "tag:llm-node:22"]},
    {"src": "autogroup:member", "accept": ["tag:master:8443"],
     "deny": ["tag:llm-node:11434", "tag:llm-node:11435", "tag:llm-node:12434", "tag:llm-node:1234", "tag:llm-node:8000", "tag:llm-node:8080", "tag:llm-node:11436"]},
  ],
}
