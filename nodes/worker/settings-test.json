{
  "permissions": {
    "allow": [
      "Bash"
    ]
  },
  "enabledPlugins": {},
  "promptSuggestionEnabled": false,
  "autoDreamEnabled": false,
  "awaySummaryEnabled": false,
  "spinnerTipsEnabled": false,
  "autoMemoryEnabled": false,
  "env": {
    "CLAUDE_CODE_GOAL_CHECKIN_MINUTES": "0"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 nodes/worker/quiet_bash.py"
          }
        ]
      }
    ]
  }
}
